# AineNext instance API root (include /api)
AINE_BASE_URL=https://your-instance.example/api

# Project UUID from Project settings → API Access
AINE_PROJECT_ID=

# Project API token from Project settings → API Tokens (server-only, never expose to the browser)
AINE_API_KEY=

# NextAuth / Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Optional: public site origin used when Site Settings → site-url is empty
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shared secret for Aine webhooks that refresh the page cache (server-only).
# When set, webhooks invalidate affected paths immediately; the 1-hour ISR baseline still applies.
# REVALIDATE_SECRET=

# Optional: map Aine collection_id → slug for delete/trash webhooks without content_entry.
# REVALIDATION_COLLECTION_IDS={"12":"courses","13":"plans"}

# Node.js: set to 0 only for local dev with self-signed TLS (e.g. Laravel Herd)
# NODE_TLS_REJECT_UNAUTHORIZED=0
