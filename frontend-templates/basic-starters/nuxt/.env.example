# AineNext instance API root (include /api)
AINE_BASE_URL=https://your-instance.example/api

# Project UUID from Project settings → API Access
AINE_PROJECT_ID=

# Project API token from Project settings → API Tokens (server-only, never public)
AINE_API_KEY=

# Optional: public site origin (maps to runtimeConfig.public.siteUrl)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional hosted overrides (same values as AINE_* above):
# NUXT_AINE_BASE_URL=
# NUXT_AINE_PROJECT_ID=
# NUXT_AINE_API_KEY=

# Node.js: set to 0 only for local dev with self-signed TLS (e.g. Laravel Herd)
# NODE_TLS_REJECT_UNAUTHORIZED=0
